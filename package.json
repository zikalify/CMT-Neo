{
  "name": "cmt-neo",
  "version": "1.0.0",
  "private": true,
  "description": "CMT-Neo — minimal cycle tracker",
  "scripts": {
    "test": "node --test tests/",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test tests/",
    "test:coverage:check": "c8 --reporter=text --check-coverage --lines 65 --branches 85 --functions 80 node --test tests/",
    "lint": "eslint app.js tests/ e2e/ playwright.config.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.5"
  }
}
